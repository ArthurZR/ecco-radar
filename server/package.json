{
  "name": "@radar/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/",
    "start": "node dist/index.js",
    "worker": "tsx --env-file=.env src/worker.ts",
    "migrate": "tsx --env-file=.env src/db/migrate-cli.ts",
    "create-user": "tsx --env-file=.env src/auth/create-user-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e:server": "tsx scripts/e2e-server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "csv-parse": "^7.0.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "undici": "^8.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
