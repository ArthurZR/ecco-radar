# --- Required ---
DATABASE_URL=postgres://radar:radar@localhost:5432/radar_dev
# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public origin of the web app, used for CSRF origin checks
APP_ORIGIN=http://localhost:5173
PORT=8787
NODE_ENV=development

# Docker Compose only: password for the bundled Postgres container
POSTGRES_PASSWORD=

# --- Optional source credentials (server-side only) ---
# Flickr: https://www.flickr.com/services/api/misc.api_keys.html
FLICKR_API_KEY=
# Tumblr: register an app at https://www.tumblr.com/oauth/apps (OAuth consumer key)
TUMBLR_API_KEY=
# Contact string sent in the User-Agent to Wikimedia / Internet Archive (their policies ask for one)
SOURCE_CONTACT=editor@example.com

# --- Optional AI provider (server-side only). Leave empty to disable external AI. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
